// METAMAX synchronization domain. Loaded together through prisma.config.mjs.

model SyncRun {
  id               BigInt                  @id @default(autoincrement())
  shopId           String                  @map("shop_id")
  generationId     String                  @map("generation_id")
  dataset          String
  status           WorkStatus              @default(PENDING)
  bulkOperationId  String?                 @map("bulk_operation_id")
  bulkStartInputHash String?               @map("bulk_start_input_hash")
  bulkStartFence    BigInt?                @map("bulk_start_fence")
  bulkStartOperationId String?             @map("bulk_start_operation_id")
  expectedLines    BigInt?                 @map("expected_lines")
  processedLines   BigInt                  @default(0) @map("processed_lines")
  invalidLines     BigInt                  @default(0) @map("invalid_lines")
  eofVerified      Boolean                 @default(false) @map("eof_verified")
  writesFinishedAt DateTime?               @map("writes_finished_at") @db.Timestamptz(3)
  leaseToken       String?                 @map("lease_token")
  leaseUntil       DateTime?               @map("lease_until") @db.Timestamptz(3)
  fence            BigInt                  @default(0)
  lastError        String?                 @map("last_error")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  executionId      String?                 @map("execution_id")
  executionFence   BigInt?                 @map("execution_fence")
  catalogDownload  CatalogDownload?
  chunks           SyncCheckpoint[]
  execution        CatalogImportExecution? @relation(fields: [shopId, executionId, generationId], references: [shopId, id, generationId], onUpdate: Restrict, map: "ingestion_execution_scope")
  generation       MirrorGeneration        @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)
  journal          MutationJournal[]
  dispatches       SyncDispatchDelivery[]

  @@unique([shopId, id])
  @@unique([shopId, generationId, dataset])
  @@map("ingestion_runs")
  @@schema("mirror")
}

model SyncCheckpoint {
  id          BigInt   @id @default(autoincrement())
  shopId      String   @map("shop_id")
  runId       BigInt   @map("run_id")
  ordinal     Int
  checksum    String
  lineCount   BigInt   @map("line_count")
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz(3)
  run         SyncRun  @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, runId, ordinal])
  @@map("ingestion_chunks")
  @@schema("mirror")
}

model CatalogChange {
  shopId              String                      @map("shop_id")
  productId           String                      @map("product_id")
  revision            BigInt                      @default(1)
  appliedRevision     BigInt                      @default(0) @map("applied_revision")
  dirty               Boolean                     @default(true)
  deleted             Boolean                     @default(false)
  attempts            Int                         @default(0)
  nextAttemptAt       DateTime?                   @map("next_attempt_at") @db.Timestamptz(3)
  deadLetterAt        DateTime?                   @map("dead_letter_at") @db.Timestamptz(3)
  lastError           String?                     @map("last_error")
  leaseToken          String?                     @map("lease_token")
  leaseUntil          DateTime?                   @map("lease_until") @db.Timestamptz(3)
  fence               BigInt                      @default(0)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant            Shop                        @relation(fields: [shopId], references: [id])
  generationRevisions GenerationProductRevision[]
  journal             MutationJournal[]

  @@id([shopId, productId])
  @@index([shopId, nextAttemptAt, productId], map: "catalog_changes_due", where: raw("(dirty AND (dead_letter_at IS NULL))"))
  @@map("catalog_changes")
  @@schema("mirror")
}

model MutationJournal {
  id          BigInt        @id @default(autoincrement())
  shopId      String        @map("shop_id")
  productId   String        @map("product_id")
  revision    BigInt
  sourceKey   String        @map("source_key")
  source      String
  deleted     Boolean       @default(false)
  syncRunId   BigInt?       @map("sync_run_id")
  payloadHash String?       @map("payload_hash")
  recordedAt  DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)
  appliedAt   DateTime?     @map("applied_at") @db.Timestamptz(3)
  purgeAfter  DateTime?     @map("purge_after") @db.Timestamptz(3)
  change      CatalogChange @relation(fields: [shopId, productId], references: [shopId, productId])
  syncRun     SyncRun?      @relation(fields: [shopId, syncRunId], references: [shopId, id])

  @@unique([shopId, sourceKey])
  @@unique([shopId, productId, revision])
  @@map("mutation_journal")
  @@schema("mirror")
}

model WebhookReceipt {
  id          BigInt    @id @default(autoincrement())
  shopId      String    @map("shop_id")
  eventId     String    @map("event_id")
  topic       String
  payloadHash String    @map("payload_hash")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  merchant    Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, eventId])
  @@map("webhook_receipts")
  @@schema("mirror")
}

model GenerationProductRevision {
  shopId       String           @map("shop_id")
  generationId String           @map("generation_id")
  productId    String           @map("product_id")
  revision     BigInt
  deleted      Boolean          @default(false)
  appliedAt    DateTime         @default(now()) @map("applied_at") @db.Timestamptz(3)
  generation   MirrorGeneration @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)
  change       CatalogChange    @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@id([shopId, generationId, productId])
  @@map("generation_product_revisions")
  @@schema("mirror")
}
