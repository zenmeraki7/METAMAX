// METAMAX reliability domain. Loaded through prisma.config.mjs.

model OutboxEvent {
  id             BigInt     @id @default(autoincrement())
  shopId         String     @map("shop_id")
  commandId      BigInt     @map("command_id")
  dedupeKey      String     @map("dedupe_key")
  availableAt    DateTime   @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt   DateTime?  @map("dispatched_at") @db.Timestamptz(3)
  attempts       Int        @default(0)
  leaseToken     String?    @map("lease_token")
  leaseUntil     DateTime?  @map("lease_until") @db.Timestamptz(3)
  fence          BigInt     @default(0)
  reviewRequired Boolean    @default(false) @map("review_required")
  lastError      String?    @map("last_error")
  command        JobCommand @relation(fields: [shopId, commandId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, dedupeKey])
  @@index([availableAt, id], map: "outbox_events_due", where: raw("(dispatched_at IS NULL)"))
  @@map("outbox_events")
  @@schema("mirror")
}

model IdempotencyRecord {
  shopId      String      @map("shop_id")
  operation   String
  key         String
  requestHash String      @map("request_hash")
  status      WorkStatus  @default(PENDING)
  commandId   BigInt?     @map("command_id")
  leaseToken  String?     @map("lease_token")
  leaseUntil  DateTime?   @map("lease_until") @db.Timestamptz(3)
  fence       BigInt      @default(0)
  response    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  command     JobCommand? @relation(fields: [shopId, commandId], references: [shopId, id])
  merchant    Shop        @relation(fields: [shopId], references: [id])

  @@id([shopId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("mirror")
}
