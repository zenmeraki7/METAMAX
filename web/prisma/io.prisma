// Migration-owned Edit History schema.

model ImportPreview {
  id               String            @id
  shopId           String            @map("shop_id")
  snapshotId       String            @map("snapshot_id")
  status           String            @default("DRAFT")
  payload          Json
  canonicalPreview String            @map("canonical_preview")
  previewHash      String            @map("preview_hash")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  contractId       String?           @map("contract_id")
  approvedBy       String?           @map("approved_by")
  approvedAt       DateTime?         @map("approved_at") @db.Timestamptz(3)
  contract         PreviewContract?  @relation(fields: [shopId, contractId], references: [shopId, id], onUpdate: NoAction)
  snapshot         SelectionSnapshot @relation(fields: [shopId, snapshotId], references: [shopId, id], onUpdate: NoAction)

  @@unique([shopId, id])
  @@map("import_previews")
  @@schema("mirror")
}

model ExportJob {
  id                  String            @id
  shopId              String            @map("shop_id")
  commandId           BigInt            @map("command_id")
  installationVersion String            @map("installation_version")
  generationId        String            @map("generation_id")
  coverageRevision    String            @map("coverage_revision")
  mappingVersion      String            @map("mapping_version")
  snapshotId          String            @map("snapshot_id")
  readLeaseId         String            @map("read_lease_id")
  format              String
  status              String            @default("QUEUED")
  attempts            Int               @default(0)
  fence               BigInt            @default(0)
  leaseToken          String?           @map("lease_token")
  leaseUntil          DateTime?         @map("lease_until") @db.Timestamptz(3)
  nextAttemptAt       DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  artifactKey         String?           @map("artifact_key")
  sha256              String?
  byteLength          BigInt?           @map("byte_length")
  rowCount            BigInt?           @map("row_count")
  lastError           String?           @map("last_error")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)
  command             JobCommand        @relation(fields: [shopId, commandId], references: [shopId, id], onUpdate: NoAction)
  generation          MirrorGeneration  @relation(fields: [shopId, generationId, coverageRevision, mappingVersion], references: [shopId, id, coverageRevision, mappingVersion], onUpdate: Restrict)
  snapshot            SelectionSnapshot @relation(fields: [shopId, snapshotId], references: [shopId, id], onUpdate: NoAction)

  @@unique([shopId, id])
  @@unique([shopId, commandId, format])
  @@map("export_jobs")
  @@schema("mirror")
}

model ExportManifestJob {
  id                  String                @id @db.Uuid
  shopId              String                @map("shop_id")
  installationId      String                @map("installation_id")
  idempotencyKey      String                @map("idempotency_key")
  requestFingerprint  String                @map("request_fingerprint")
  manifestFingerprint String                @map("manifest_fingerprint")
  contractVersion     Int                   @map("contract_version")
  manifestVersion     Int                   @map("manifest_version")
  generationId        String                @map("generation_id")
  coverageRevision    String                @map("coverage_revision")
  mappingVersion      String                @map("mapping_version")
  readLeaseId         String                @map("read_lease_id")
  manifest            Json
  state               String                @default("QUEUED")
  attempts            Int                   @default(0)
  fenceEpoch          BigInt                @default(0) @map("fence_epoch")
  leaseToken          String?               @map("lease_token") @db.Uuid
  leaseExpiresAt      DateTime?             @map("lease_expires_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(3)
  outbox              ExportDispatchOutbox?
  merchant            Shop                  @relation(fields: [shopId], references: [id], onUpdate: Restrict)
  generation          MirrorGeneration      @relation(fields: [shopId, generationId, coverageRevision, mappingVersion], references: [shopId, id, coverageRevision, mappingVersion], onUpdate: Restrict)
  readLease           GenerationReadLease   @relation(fields: [shopId, readLeaseId], references: [shopId, id], onUpdate: Restrict)

  @@unique([shopId, id])
  @@unique([shopId, installationId, idempotencyKey], map: "export_manifest_jobs_idempotency_unique")
  @@index([shopId, state, createdAt], map: "export_manifest_jobs_shop_state_idx")
  @@map("export_manifest_jobs")
  @@schema("mirror")
}

model ExportDispatchOutbox {
  id             BigInt            @id @default(autoincrement())
  shopId         String            @map("shop_id")
  installationId String            @map("installation_id")
  exportJobId    String            @map("export_job_id") @db.Uuid
  dedupeKey      String            @map("dedupe_key")
  payload        Json
  availableAt    DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt   DateTime?         @map("dispatched_at") @db.Timestamptz(3)
  attempts       Int               @default(0)
  leaseToken     String?           @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?         @map("lease_expires_at") @db.Timestamptz(3)
  fenceEpoch     BigInt            @default(0) @map("fence_epoch")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  exportJob      ExportManifestJob @relation(fields: [shopId, exportJobId], references: [shopId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([shopId, dedupeKey])
  @@unique([shopId, exportJobId])
  @@index([availableAt, id], map: "export_dispatch_outbox_due_idx", where: raw("(dispatched_at IS NULL)"))
  @@map("export_dispatch_outbox")
  @@schema("mirror")
}
