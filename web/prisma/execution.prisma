// METAMAX execution domain. Loaded together through prisma.config.mjs.

model SelectionSnapshot {
  shopId              String               @map("shop_id")
  id                  String               @default(uuid())
  generationId        String               @map("generation_id")
  coverageRevision    String               @map("coverage_revision")
  mappingVersion      String               @map("mapping_version")
  operation           String
  operationId         String               @map("operation_id")
  status              ApprovalStatus       @default(DRAFT)
  filterAst           Json                 @map("filter_ast")
  filterFingerprint   String               @map("filter_fingerprint")
  registryVersion     String               @map("registry_version")
  definitionRevisions Json                 @map("definition_revisions")
  selectedCount       BigInt               @default(0) @map("selected_count")
  selectionHash       String?              @map("selection_hash")
  frozenAt            DateTime?            @map("frozen_at") @db.Timestamptz(3)
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  historyLock        Int                  @default(0) @map("_history_lock")
  installationVersion String?              @map("installation_version")
  targetMode          String?              @map("target_mode")
  contracts           PreviewContract[]
  exportJobs          ExportJob[]
  importPreviews      ImportPreview[]
  scheduleOccurrences ScheduleOccurrence[]
  items               SelectionItem[]
  generation          MirrorGeneration     @relation(fields: [shopId, generationId, coverageRevision, mappingVersion], references: [shopId, id, coverageRevision, mappingVersion], onUpdate: Restrict)

  @@id([shopId, id])
  @@unique([shopId, id, generationId])
  @@index([shopId, expiresAt])
  @@map("selection_snapshots")
  @@schema("mirror")
}

model SelectionItem {
  id           BigInt            @id @default(autoincrement())
  shopId       String            @map("shop_id")
  snapshotId   String            @map("snapshot_id")
  generationId String            @map("generation_id")
  productId    BigInt            @map("product_id")
  product      SnapshotProduct   @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id])
  snapshot     SelectionSnapshot @relation(fields: [shopId, snapshotId, generationId], references: [shopId, id, generationId], onDelete: Cascade)

  @@unique([shopId, snapshotId, productId])
  @@map("selection_items")
  @@schema("mirror")
}

enum ApprovalStatus {
  DRAFT
  APPROVED
  REVOKED
  EXPIRED

  @@schema("mirror")
}
