// METAMAX fields domain. Loaded together through prisma.config.mjs.

model FieldMapping {
  shopId          String           @map("shop_id")
  generationId    String           @map("generation_id")
  fieldId         String           @map("field_id")
  mappingVersion  String           @map("mapping_version")
  entity          String
  columnName      String           @map("column_name")
  storageType     String           @map("storage_type")
  definitionToken String?          @map("definition_token")
  verifiedAt      DateTime         @map("verified_at") @db.Timestamptz(3)
  generation      MirrorGeneration @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, generationId, fieldId])
  @@map("field_mappings")
  @@schema("mirror")
}

model MetafieldDefinition {
  id                    BigInt           @id @default(autoincrement())
  shopId                String           @map("shop_id")
  fieldId               String           @map("field_id")
  shopifyDefinitionId   String           @map("shopify_definition_id")
  locatorId             String           @map("locator_id")
  ownerEntity           OwnerEntity      @map("owner_entity")
  namespace             String
  key                   String
  shopifyType           String           @map("shopify_type")
  canonicalType         String           @map("canonical_type")
  label                 String
  definitionToken       String           @map("definition_token")
  status                String           @default("UNVERIFIED")
  definitionVerified    Boolean          @default(false) @map("definition_verified")
  nullable              Boolean          @default(true)
  writable              Boolean          @default(false)
  mutationSupported     Boolean          @default(false) @map("mutation_supported")
  readerAdapterId       String?          @map("reader_adapter_id")
  writerAdapterId       String?          @map("writer_adapter_id")
  precision             Int?
  scale                 Int?
  constraints           Json?
  verifiedAt            DateTime?        @map("verified_at") @db.Timestamptz(3)
  verificationExpiresAt DateTime?        @map("verification_expires_at") @db.Timestamptz(3)
  merchant              Shop             @relation(fields: [shopId], references: [id])
  values                MetafieldValue[]

  @@unique([shopId, id, ownerEntity])
  @@unique([shopId, fieldId])
  @@unique([shopId, shopifyDefinitionId])
  @@unique([shopId, locatorId])
  @@unique([shopId, ownerEntity, namespace, key])
  @@map("metafield_definitions")
  @@schema("mirror")
}

model MetafieldValue {
  id              BigInt              @id @default(autoincrement())
  shopId          String              @map("shop_id")
  generationId    String              @map("generation_id")
  productId       BigInt?             @map("product_id")
  variantId       BigInt?             @map("variant_id")
  definitionId    BigInt              @map("definition_id")
  ownerEntity     OwnerEntity         @map("owner_entity")
  definitionToken String              @map("definition_token")
  valueType       String              @map("value_type")
  isNull          Boolean             @default(false) @map("is_null")
  textValue       String?             @map("text_value")
  booleanValue    Boolean?            @map("boolean_value")
  integerValue    BigInt?             @map("integer_value")
  decimalValue    Decimal?            @map("decimal_value") @db.Decimal
  dateValue       DateTime?           @map("date_value") @db.Date
  datetimeValue   DateTime?           @map("datetime_value") @db.Timestamptz(6)
  stringListValue String[]            @default([]) @map("string_list_value")
  jsonValue       Json?               @map("json_value")
  definition      MetafieldDefinition @relation(fields: [shopId, definitionId, ownerEntity], references: [shopId, id, ownerEntity])
  product         SnapshotProduct?    @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id], onDelete: Cascade)
  variant         SnapshotVariant?    @relation(fields: [shopId, generationId, variantId], references: [shopId, generationId, id], onDelete: Cascade)

  @@unique([shopId, generationId, productId, definitionId])
  @@unique([shopId, generationId, variantId, definitionId])
  @@index([shopId, generationId, definitionId, id])
  @@index([shopId, generationId, definitionId, decimalValue, id], map: "metafield_values_decimal", where: raw("((value_type = 'decimal'::text) AND (NOT is_null))"))
  @@index([shopId, generationId, definitionId, textValue, id], map: "metafield_values_text", where: raw("((value_type = 'string'::text) AND (NOT is_null))"))
  @@map("metafield_values")
  @@schema("mirror")
}

enum OwnerEntity {
  product
  variant

  @@schema("mirror")
}
