// Undo stores only touched field values, never another full catalog mirror.
model ProductSnapshot {
  id             BigInt     @id @default(autoincrement())
  shopId         String     @map("shop_id")
  editItemId     BigInt     @map("edit_item_id")
  beforeValues   Json       @map("before_values")
  beforeHash     String?    @map("before_hash")
  afterHash      String?    @map("after_hash")
  beforeRevision BigInt?    @map("before_revision")
  afterRevision  BigInt?    @map("after_revision")
  capturedAt     DateTime   @default(now()) @map("captured_at") @db.Timestamptz(3)
  confirmedAt    DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  historyLock   Int        @default(0) @map("_history_lock")
  restorations   EditItem[] @relation("RestoreSnapshot")
  item           EditItem   @relation("CapturedSnapshot", fields: [shopId, editItemId], references: [shopId, id])

  @@unique([shopId, id])
  @@unique([shopId, editItemId])
  @@map("product_snapshots")
  @@schema("mirror")
}

model UndoOperation {
  id                 BigInt        @id @default(autoincrement())
  shopId             String        @map("shop_id")
  sourceOperationId  BigInt        @map("source_operation_id")
  restoreOperationId BigInt        @map("restore_operation_id")
  mode               String        @default("COMPARE_AFTER_HASH")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  restoreOperation   EditOperation @relation("UndoRestore", fields: [shopId, restoreOperationId], references: [shopId, id])
  sourceOperation    EditOperation @relation("UndoSource", fields: [shopId, sourceOperationId], references: [shopId, id])

  @@unique([shopId, restoreOperationId])
  @@map("undo_operations")
  @@schema("mirror")
}
