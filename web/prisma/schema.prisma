generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  domain      String   @id
  activeRunId String?
  activeSnapshotId String?
  status      String   @default("ACTIVE")
  generation  String   @default(uuid())
  installationVerified Boolean @default(false)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  changes     CatalogChange[]
  receipts    WebhookEvent[]
  products    ProductMirror[]
  snapshots   SnapshotRun[]
  catalogSync CatalogSyncState?
  repairs     CatalogRepair[]
  alerts      OperationalAlert[]
  inventoryChanges InventoryChange[]
  initialSyncRequests InitialSyncRequest[]
  publishedSnapshot SnapshotRun? @relation("PublishedSnapshot", fields: [domain, generation, activeSnapshotId], references: [shop, generation, id], onDelete: Restrict, onUpdate: NoAction, map: "Shop_published_snapshot_fkey")
}

model InitialSyncRequest {
  shop         String
  generation   String
  status       String   @default("PENDING")
  snapshotId   String?
  attempts     Int      @default(0)
  nextCheckAt  DateTime @default(now())
  leaseToken   String?
  leasedUntil  DateTime?
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  merchant     Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, generation])
  @@index([status, nextCheckAt, leasedUntil])
}

model WebhookEvent {
  id          String   @id
  shop        String
  topic       String
  resourceId  String
  eventId     String
  payloadHash String
  triggeredAt DateTime
  revision    BigInt?
  status      String
  processedAt DateTime
  createdAt   DateTime @default(now())
  merchant    Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@index([shop, resourceId, revision])
  @@index([createdAt, id])
}

model CatalogChange {
  shop            String
  productId       String
  revision        BigInt   @default(1)
  appliedRevision BigInt   @default(0)
  dirty           Boolean  @default(true)
  attempts        Int      @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  deadLetterAt    DateTime?
  manualRetryAt   DateTime?
  leaseToken      String?
  leasedUntil     DateTime?
  waitingForSnapshot Boolean @default(false)
  updatedAt       DateTime @updatedAt
  merchant        Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, productId])
  @@index([dirty, deadLetterAt, nextAttemptAt, shop, productId])
}

model ProductMirror {
  shop      String
  productId String
  data      Json
  revision  BigInt
  updatedAt DateTime @updatedAt
  merchant  Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, productId])
}

model SnapshotRun {
  id          String   @id @default(uuid())
  shop        String
  status      String   @default("INGESTING")
  createdAt   DateTime @default(now())
  completedAt DateTime?
  generation String?
  expectedProducts Int?
  importedProducts Int @default(0)
  leaseToken String?
  leasedUntil DateTime?
  nextCheckAt DateTime @default(now())
  attempts Int @default(0)
  lastError String?
  exportName String @default("products")
  bulkOperationId String?
  exportManifest Json @default("{}")
  merchant    Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)
  changes     SnapshotChange[]
  products    SnapshotProduct[]
  inventoryItems InventoryItem[]
  inventoryLocations InventoryLocation[]
  variants Variant[]
  datasets SnapshotDataset[]
  inventoryChanges SnapshotInventoryChange[]
  publications Shop[] @relation("PublishedSnapshot")
  retentionPins SnapshotRetentionPin[]

  @@unique([shop, id])
  @@unique([shop, generation, id])
  @@index([status, completedAt, id])
  @@index([status, nextCheckAt, leasedUntil])
}

model SnapshotProduct {
  runId String
  productId String
  data Json
  snapshot SnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@id([runId, productId])
}

model SnapshotChange {
  runId     String
  productId String
  revision  BigInt
  appliedRevision BigInt @default(0)
  dirty     Boolean  @default(true)
  snapshot  SnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, productId])
  @@index([runId, dirty, productId])
}

// No raw webhook body, customer identity, token, or shop domain is retained here.
// Hashed shop identity supports idempotent cleanup after tenant deletion.
model LifecycleReceipt {
  id          String   @id
  shopHash    String
  topic       String
  payloadHash String
  outcome     String
  createdAt   DateTime @default(now())

  @@index([shopHash, createdAt])
}

model CatalogSyncState {
  shop       String   @id
  generation String
  status     String   @default("NOT_STARTED")
  requiredDatasets String[] @default(["products", "variants"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Shop     @relation(fields: [shop], references: [domain], onDelete: Cascade)
}

// An indexed projection of the canonical product JSON. The inventory reference
// deliberately has no FK or uniqueness constraint: datasets load independently.
model Variant {
  shop String
  snapshotId String
  id String
  productId String
  inventoryItemId String?
  snapshot SnapshotRun @relation(fields: [shop, snapshotId], references: [shop, id], onDelete: Cascade)
  product SnapshotProduct @relation(fields: [snapshotId, productId], references: [runId, productId], onDelete: Cascade)

  @@id([shop, snapshotId, id])
  @@index([shop, snapshotId, inventoryItemId])
  @@index([shop, snapshotId, productId])
}

model InventoryItem {
  shop String
  snapshotId String
  id String
  sku String?
  tracked Boolean
  requiresShipping Boolean
  sourceUpdatedAt DateTime
  levels InventoryLevel[]
  snapshot SnapshotRun @relation(fields: [shop, snapshotId], references: [shop, id], onDelete: Cascade)

  @@id([shop, snapshotId, id])
  @@index([shop, snapshotId, sku])
}

model InventoryChange {
  shop String
  inventoryItemId String
  revision BigInt @default(1)
  appliedRevision BigInt @default(0)
  dirty Boolean @default(true)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leasedUntil DateTime?
  attempts Int @default(0)
  lastError String?
  deadLetterAt DateTime?
  manualRetryAt DateTime?
  waitingForSnapshot Boolean @default(false)
  updatedAt DateTime @updatedAt
  merchant Shop @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, inventoryItemId])
  @@index([dirty, nextAttemptAt, leasedUntil])
  @@index([shop, dirty, deadLetterAt, nextAttemptAt])
}

model SnapshotInventoryChange {
  runId String
  inventoryItemId String
  revision BigInt
  appliedRevision BigInt @default(0)
  dirty Boolean @default(true)
  snapshot SnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, inventoryItemId])
  @@index([runId, dirty, inventoryItemId])
}

model InventoryLocation {
  shop String
  snapshotId String
  id String
  name String
  isActive Boolean
  fulfillsOnlineOrders Boolean
  sourceUpdatedAt DateTime
  levels InventoryLevel[]
  snapshot SnapshotRun @relation(fields: [shop, snapshotId], references: [shop, id], onDelete: Cascade)

  @@id([shop, snapshotId, id])
}

model InventoryLevel {
  shop String
  snapshotId String
  inventoryItemId String
  locationId String
  shopifyLevelId String
  isActive Boolean
  sourceUpdatedAt DateTime
  item InventoryItem @relation(fields: [shop, snapshotId, inventoryItemId], references: [shop, snapshotId, id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [shop, snapshotId, locationId], references: [shop, snapshotId, id], onDelete: Cascade)
  quantities InventoryQuantity[]

  @@id([shop, snapshotId, inventoryItemId, locationId])
  @@index([shop, snapshotId, locationId])
}

model InventoryQuantity {
  shop String
  snapshotId String
  inventoryItemId String
  locationId String
  name String
  quantity Int
  sourceUpdatedAt DateTime?
  level InventoryLevel @relation(fields: [shop, snapshotId, inventoryItemId, locationId], references: [shop, snapshotId, inventoryItemId, locationId], onDelete: Cascade)

  @@id([shop, snapshotId, inventoryItemId, locationId, name])
  @@index([shop, snapshotId, locationId, name])
}

model SnapshotDataset {
  runId String
  name String
  expectedRecords BigInt
  importedRecords BigInt
  completedAt DateTime @default(now())
  snapshot SnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, name])
}

model OperationalAlert {
  shop String
  code String
  occurrences Int @default(1)
  message String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  resolvedAt DateTime?
  merchant Shop @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, code])
  @@index([resolvedAt, lastSeenAt])
}

// Minimal lifecycle fence independent of Shop, so a missing/corrupted Shop row
// can be repaired without resurrecting a confirmed uninstalled installation.
model InstallationState {
  shopHash        String   @id
  status          String
  generation      String
  authenticatedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@index([status, updatedAt])
}

enum CatalogRepairKind {
  PRODUCT
  VARIANT
  INVENTORY_ITEM
  INVENTORY_LEVEL
  FULL
}

model CatalogRepair {
  shop String
  kind CatalogRepairKind

  // Incremental scan progress
  coveredThrough DateTime?
  windowFrom DateTime?
  windowTo DateTime?
  afterCursor String? @db.Text
  pagesInWindow Int @default(0)

  // Durable scheduling and ownership
  nextCheckAt DateTime @default(now())
  leaseToken String?
  leasedUntil DateTime?

  attempts Int @default(0)
  lastError String? @db.Text

  merchant Shop @relation(fields: [shop], references: [domain], onDelete: Cascade)

  @@id([shop, kind])
  @@index([nextCheckAt, leasedUntil])
}


// Active consumers pin a snapshot explicitly. Removing a snapshot with any pin
// is rejected by the database; consumers release pins when they finish.
model SnapshotRetentionPin {
  shop String
  snapshotId String
  kind String
  ownerId String
  createdAt DateTime @default(now())
  snapshot SnapshotRun @relation(fields: [shop, snapshotId], references: [shop, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shop, snapshotId, kind, ownerId])
}

// One capacity pool per app/shop, shared by catalogue sync and future exports.
// Unknown outcomes keep their slot until Shopify evidence resolves them.
model BulkQueryClaim {
  appId String
  shop String
  requestKey String
  generation String
  consumer String
  slot Int?
  state String @default("RESERVED")
  operationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([appId, shop, requestKey])
  @@unique([appId, shop, slot])
  @@unique([appId, shop, operationId])
}
