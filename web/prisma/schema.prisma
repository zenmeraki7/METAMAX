// METAMAX schema entry point. Models are grouped in adjacent domain files.
// Load the entire prisma/ directory; see prisma/README.md.

// METAMAX shared catalog and execution storage. Prisma ORM 7.
// The initial migration includes mandatory custom checks/triggers; see README.md.
// Storage metadata is never a permission grant or a compiler binding issuer.
generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["edit_history", "export_engine", "mirror"]
}
