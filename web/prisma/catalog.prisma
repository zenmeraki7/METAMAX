// METAMAX catalog domain. Loaded through prisma.config.mjs.

model SnapshotProduct {
  id              BigInt                 @id @default(autoincrement())
  shopId          String                 @map("shop_id") @db.Text
  generationId    String                 @map("generation_id") @db.Text
  shopifyId       String                 @map("shopify_id") @db.Text
  title           String                 @db.Text
  handle          String                 @db.Text
  descriptionHtml String?                @map("description_html") @db.Text
  vendor          String?                @db.Text
  productType     String?                @map("product_type") @db.Text
  status          String                 @db.Text
  tags            String[]               @default([])
  templateSuffix  String?                @map("template_suffix") @db.Text
  seoTitle        String?                @map("seo_title") @db.Text
  seoDescription  String?                @map("seo_description") @db.Text
  categoryId      String?                @map("category_id") @db.Text
  createdAt       DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @map("updated_at") @db.Timestamptz(3)
  publishedAt     DateTime?              @map("published_at") @db.Timestamptz(3)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(3)
  sourceRevision  BigInt                 @default(0) @map("source_revision")
  attributes      Json?                  @db.JsonB
  generation      MirrorGeneration       @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)
  variants        SnapshotVariant[]
  options         ProductOption[]
  collections     CollectionMembership[]
  metafields      MetafieldValue[]
  selectedBy      SelectionItem[]

  @@unique([shopId, generationId, shopifyId])
  @@unique([shopId, generationId, id])
  @@index([shopId, generationId, status, id])
  @@map("products")
  @@schema("mirror")
}

model SnapshotVariant {
  id                 BigInt           @id @default(autoincrement())
  shopId             String           @map("shop_id") @db.Text
  generationId       String           @map("generation_id") @db.Text
  shopifyId          String           @map("shopify_id") @db.Text
  productId          BigInt           @map("product_id")
  inventoryItemId    BigInt?          @map("inventory_item_id")
  title              String           @db.Text
  sku                String?          @db.Text
  barcode            String?          @db.Text
  // @db.Decimal without arguments emits unconstrained NUMERIC (no typmod).
  price              Decimal          @db.Decimal
  compareAtPrice     Decimal?         @map("compare_at_price") @db.Decimal
  inventoryPolicy    String           @map("inventory_policy") @db.Text
  inventoryQuantity  BigInt           @map("inventory_quantity")
  taxable            Boolean
  requiresComponents Boolean          @map("requires_components")
  position           BigInt
  createdAt          DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)
  sourceRevision     BigInt           @default(0) @map("source_revision")
  attributes         Json?            @db.JsonB
  product            SnapshotProduct  @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id], onDelete: Cascade)
  inventoryItem      InventoryItem?   @relation(fields: [shopId, generationId, inventoryItemId], references: [shopId, generationId, id], onDelete: Restrict)
  metafields         MetafieldValue[]

  @@unique([shopId, generationId, shopifyId])
  @@unique([shopId, generationId, id])
  @@index([shopId, generationId, productId, id])
  @@index([shopId, generationId, sku, productId])
  @@map("variants")
  @@schema("mirror")
}

model ProductOption {
  id           BigInt          @id @default(autoincrement())
  shopId       String          @map("shop_id") @db.Text
  generationId String          @map("generation_id") @db.Text
  shopifyId    String          @map("shopify_id") @db.Text
  productId    BigInt          @map("product_id")
  name         String          @db.Text
  position     BigInt
  values       String[]        @default([])
  product      SnapshotProduct @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id], onDelete: Cascade)

  @@unique([shopId, generationId, shopifyId])
  @@index([shopId, generationId, productId, position])
  @@map("product_options")
  @@schema("mirror")
}

model Category {
  id           BigInt           @id @default(autoincrement())
  shopId       String           @map("shop_id") @db.Text
  generationId String           @map("generation_id") @db.Text
  shopifyId    String           @map("shopify_id") @db.Text
  name         String           @db.Text
  fullName     String           @map("full_name") @db.Text
  generation   MirrorGeneration @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, generationId, shopifyId])
  @@map("categories")
  @@schema("mirror")
}
