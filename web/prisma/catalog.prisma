// METAMAX catalog domain. Loaded through prisma.config.mjs.

model SnapshotProduct {
  id              BigInt                 @id @default(autoincrement())
  shopId          String                 @map("shop_id")
  generationId    String                 @map("generation_id")
  shopifyId       String                 @map("shopify_id")
  title           String
  handle          String
  descriptionHtml String?                @map("description_html")
  vendor          String?
  productType     String?                @map("product_type")
  status          String
  tags            String[]               @default([])
  templateSuffix  String?                @map("template_suffix")
  seoTitle        String?                @map("seo_title")
  seoDescription  String?                @map("seo_description")
  categoryId      String?                @map("category_id")
  createdAt       DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @map("updated_at") @db.Timestamptz(3)
  publishedAt     DateTime?              @map("published_at") @db.Timestamptz(3)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(3)
  sourceRevision  BigInt                 @default(0) @map("source_revision")
  attributes      Json?
  historyLock    Int                    @default(0) @map("_history_lock")
  metafields      MetafieldValue[]
  collections     CollectionMembership[]
  options         ProductOption[]
  generation      MirrorGeneration       @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)
  selectedBy      SelectionItem[]
  variants        SnapshotVariant[]

  @@unique([shopId, generationId, shopifyId])
  @@unique([shopId, generationId, id])
  @@index([shopId, generationId, status, id])
  @@map("products")
  @@schema("mirror")
}

model SnapshotVariant {
  id                 BigInt           @id @default(autoincrement())
  shopId             String           @map("shop_id")
  generationId       String           @map("generation_id")
  shopifyId          String           @map("shopify_id")
  productId          BigInt           @map("product_id")
  inventoryItemId    BigInt?          @map("inventory_item_id")
  title              String
  sku                String?
  barcode            String?
  price              Decimal          @db.Decimal
  compareAtPrice     Decimal?         @map("compare_at_price") @db.Decimal
  inventoryPolicy    String           @map("inventory_policy")
  inventoryQuantity  BigInt           @map("inventory_quantity")
  taxable            Boolean
  requiresComponents Boolean          @map("requires_components")
  position           BigInt
  createdAt          DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)
  sourceRevision     BigInt           @default(0) @map("source_revision")
  attributes         Json?
  metafields         MetafieldValue[]
  inventoryItem      InventoryItem?   @relation(fields: [shopId, generationId, inventoryItemId], references: [shopId, generationId, id])
  product            SnapshotProduct  @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id], onDelete: Cascade)

  @@unique([shopId, generationId, shopifyId])
  @@unique([shopId, generationId, id])
  @@index([shopId, generationId, productId, id])
  @@index([shopId, generationId, sku, productId])
  @@map("variants")
  @@schema("mirror")
}

model ProductOption {
  id           BigInt          @id @default(autoincrement())
  shopId       String          @map("shop_id")
  generationId String          @map("generation_id")
  shopifyId    String          @map("shopify_id")
  productId    BigInt          @map("product_id")
  name         String
  position     BigInt
  values       String[]        @default([])
  product      SnapshotProduct @relation(fields: [shopId, generationId, productId], references: [shopId, generationId, id], onDelete: Cascade)

  @@unique([shopId, generationId, shopifyId])
  @@index([shopId, generationId, productId, position])
  @@map("product_options")
  @@schema("mirror")
}

model Category {
  id           BigInt           @id @default(autoincrement())
  shopId       String           @map("shop_id")
  generationId String           @map("generation_id")
  shopifyId    String           @map("shopify_id")
  name         String
  fullName     String           @map("full_name")
  generation   MirrorGeneration @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, generationId, shopifyId])
  @@map("categories")
  @@schema("mirror")
}
