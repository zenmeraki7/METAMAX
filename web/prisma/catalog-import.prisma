// Migration-owned Edit History schema.

model CatalogImportJob {
  id                   String                  @id
  shopId               String                  @unique(map: "catalog_import_active_shop", where: raw("(status = ANY (ARRAY['QUEUED'::text, 'RUNNING'::text, 'RETRY'::text]))")) @map("shop_id")
  installationVersion  String                  @map("installation_version")
  status               String                  @default("QUEUED")
  generationId         String?                 @map("generation_id")
  runId                BigInt?                 @map("run_id")
  expectedGenerationId String?                 @map("expected_generation_id")
  attempts             Int                     @default(0)
  fence                BigInt                  @default(0)
  leaseUntil           DateTime?               @map("lease_until") @db.Timestamptz(3)
  nextAttemptAt        DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  cancelRequested      Boolean                 @default(false) @map("cancel_requested")
  lastError            String?                 @map("last_error")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @default(now()) @map("updated_at") @db.Timestamptz(3)
  executionMode        String                  @default("LEGACY") @map("execution_mode")
  execution            CatalogImportExecution?
  shop                 Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, id, generationId], map: "catalog_import_execution_identity")
  @@index([status, nextAttemptAt, leaseUntil], map: "catalog_import_due")
  @@index([shopId, installationVersion, createdAt, id], map: "catalog_import_installation_history")
  @@map("catalog_import_jobs")
  @@schema("mirror")
}

model CatalogImportExecution {
  id                String                         @id
  shopId            String                         @map("shop_id")
  generationId      String                         @map("generation_id")
  phase             String                         @default("STARTING")
  attempt           Int                            @default(0)
  fence             BigInt                         @default(0)
  leaseToken        String?                        @map("lease_token")
  leaseUntil        DateTime?                      @map("lease_until") @db.Timestamptz(3)
  workerId          String?                        @map("worker_id")
  nextEligibleAt    DateTime?                      @map("next_eligible_at") @db.Timestamptz(3)
  completedAt       DateTime?                      @map("completed_at") @db.Timestamptz(3)
  reviewRequired    Boolean                        @default(false) @map("review_required")
  recoveryAttempts  Int                            @default(0) @map("recovery_attempts")
  cancelCompletedAt DateTime?                      @map("cancel_completed_at") @db.Timestamptz(3)
  outcomeUncertain  Boolean                        @default(false) @map("outcome_uncertain")
  cancelRequested   Boolean                        @default(false) @map("cancel_requested")
  lastError         String?                        @map("last_error")
  deliveryRevision  BigInt                         @default(0) @map("delivery_revision")
  generation        MirrorGeneration               @relation(fields: [shopId, generationId], references: [shopId, id], onUpdate: Restrict, map: "catalog_execution_generation")
  job               CatalogImportJob               @relation(fields: [shopId, id, generationId], references: [shopId, id, generationId], onUpdate: Restrict, map: "catalog_execution_job")
  shop              Shop                           @relation(fields: [shopId], references: [id])
  ingestions        SyncRun[]
  recoveryEvidence  SyncDispatchRecoveryEvidence[]
  deliveries        SyncDispatchDelivery[]
  operations        SyncExternalOperation[]

  @@unique([shopId, id, generationId], map: "catalog_execution_identity")
  @@index([shopId, leaseUntil], map: "catalog_execution_shop_lease")
  @@index([nextEligibleAt, id], map: "catalog_execution_due")
  @@map("catalog_import_executions")
  @@schema("mirror")
}

model SyncDispatchShop {
  shopId           String    @id @map("shop_id")
  lastServed       BigInt    @default(0) @map("last_served")
  lastDispatchedAt DateTime? @map("last_dispatched_at") @db.Timestamptz(3)
  nextEligibleAt   DateTime  @default(now()) @map("next_eligible_at") @db.Timestamptz(3)
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sync_dispatch_schedule_shop_fk")

  @@index([nextEligibleAt, lastDispatchedAt, shopId], map: "sync_dispatch_schedule_due_idx")
  @@map("sync_dispatch_schedule")
  @@schema("mirror")
}

model SyncDispatchDelivery {
  id                 String                         @id
  shopId             String                         @map("shop_id")
  runId              String                         @map("run_id")
  generationId       String                         @map("generation_id")
  deliveryRevision   BigInt                         @map("delivery_revision")
  kind               String
  deliveryKey        String                         @unique @map("delivery_key")
  state              String                         @default("PENDING")
  dispatchToken      String                         @map("dispatch_token")
  reservationFence   BigInt                         @map("reservation_fence")
  reservedUntil      DateTime?                      @map("reserved_until") @db.Timestamptz(3)
  jobId              String?                        @map("job_id")
  lastErrorCode      String?                        @map("last_error_code")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(3)
  nextAttemptAt      DateTime                       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  attempt            Int                            @default(0)
  enqueuedAt         DateTime?                      @map("enqueued_at") @db.Timestamptz(3)
  ingestionRunId     BigInt                         @map("sync_run_id")
  recoveryToken      String?                        @map("recovery_token")
  recoveryUntil      DateTime?                      @map("recovery_until") @db.Timestamptz(3)
  recoveryReason     String?                        @map("recovery_reason")
  consumedAt         DateTime?                      @map("consumed_at") @db.Timestamptz(3)
  reviewedAt         DateTime?                      @map("reviewed_at") @db.Timestamptz(3)
  consumedFence      BigInt?                        @map("consumed_fence")
  consumedLeaseToken String?                        @map("consumed_lease_token")
  recoveryFence      BigInt                         @default(0) @map("recovery_fence")
  recoveryEvidence   SyncDispatchRecoveryEvidence[]
  execution          CatalogImportExecution         @relation(fields: [shopId, runId, generationId], references: [shopId, id, generationId], onUpdate: Restrict, map: "sync_dispatches_execution_fk")
  shop               Shop                           @relation(fields: [shopId], references: [id], onUpdate: Restrict, map: "sync_dispatches_shop_fk")
  ingestion          SyncRun                        @relation(fields: [shopId, ingestionRunId], references: [shopId, id], onUpdate: Restrict, map: "sync_dispatches_sync_run_fk")

  @@unique([shopId, runId, deliveryRevision, kind], map: "sync_dispatches_logical_delivery_unique")
  @@unique([shopId, deliveryKey], map: "sync_dispatches_delivery_unique")
  @@index([reservedUntil, id], map: "sync_dispatch_expiry")
  @@index([shopId, runId, createdAt], map: "sync_dispatches_run_idx")
  @@index([updatedAt, id], map: "sync_dispatch_consumed_idx", where: raw("(state = 'CONSUMED'::text)"))
  @@index([nextAttemptAt, shopId], map: "sync_dispatch_due_idx", where: raw("(state = ANY (ARRAY['PENDING'::text, 'RETRY_ELIGIBLE'::text]))"))
  @@index([updatedAt, id], map: "sync_dispatch_recovery_idx", where: raw("(state = ANY (ARRAY['UNKNOWN'::text, 'ENQUEUED'::text, 'RESERVED'::text, 'RECONCILING'::text]))"))
  @@index([nextAttemptAt, reservedUntil], map: "sync_dispatches_retry_idx", where: raw("(state = ANY (ARRAY['PENDING'::text, 'RESERVED'::text, 'UNKNOWN'::text]))"))
  @@map("sync_dispatches")
  @@schema("mirror")
}

model SyncExternalOperation {
  id            String                 @id
  shopId        String                 @map("shop_id")
  runId         String                 @map("run_id")
  generationId  String                 @map("generation_id")
  kind          String
  inputHash     String                 @map("input_hash")
  state         String
  dispatchFence BigInt                 @map("dispatch_fence")
  operationId   String?                @map("operation_id")
  remoteStatus  String?                @map("remote_status")
  objectCount   BigInt?                @map("object_count")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @default(now()) @map("updated_at") @db.Timestamptz(3)
  execution     CatalogImportExecution @relation(fields: [shopId, runId, generationId], references: [shopId, id, generationId], onUpdate: Restrict)

  @@unique([runId, kind])
  @@map("sync_external_operations")
  @@schema("mirror")
}

model SyncDispatchRecoveryEvidence {
  id               String                 @id
  dispatchId       String                 @map("dispatch_id")
  shopId           String                 @map("shop_id")
  runId            String                 @map("run_id")
  generationId     String                 @map("generation_id")
  deliveryRevision BigInt                 @map("delivery_revision")
  kind             String
  deliveryKey      String                 @map("delivery_key")
  recoveryToken    String                 @map("recovery_token")
  recoveryFence    BigInt                 @map("recovery_fence")
  decision         String
  queueState       String                 @map("queue_state")
  jobId            String                 @map("job_id")
  observedAt       DateTime               @default(dbgenerated("clock_timestamp()")) @map("observed_at") @db.Timestamptz(3)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime?              @map("consumed_at") @db.Timestamptz(3)
  dispatch         SyncDispatchDelivery   @relation(fields: [dispatchId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sync_dispatch_recovery_evidence_dispatch_fk")
  execution        CatalogImportExecution @relation(fields: [shopId, runId, generationId], references: [shopId, id, generationId], onUpdate: Restrict, map: "sync_dispatch_recovery_evidence_execution_fk")
  shop             Shop                   @relation(fields: [shopId], references: [id], onUpdate: Restrict, map: "sync_dispatch_recovery_evidence_shop_fk")

  @@unique([dispatchId, recoveryFence], map: "sync_dispatch_recovery_evidence_fence_unique")
  @@index([dispatchId, recoveryFence, expiresAt], map: "sync_dispatch_recovery_evidence_lookup_idx")
  @@map("sync_dispatch_recovery_evidence")
  @@schema("mirror")
}
