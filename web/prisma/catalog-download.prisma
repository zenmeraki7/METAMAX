// Migration-owned Edit History schema.

model CatalogDownload {
  shopId       String                 @map("shop_id")
  runId        BigInt                 @map("run_id")
  generationId String                 @map("generation_id")
  operationId  String                 @map("operation_id")
  urlHash      String                 @map("url_hash")
  etag         String
  totalBytes   BigInt                 @map("total_bytes")
  nextByte     BigInt                 @default(0) @map("next_byte")
  lineCount    BigInt                 @default(0) @map("line_count")
  pending      Bytes                  @default("")
  complete     Boolean                @default(false)
  chunks       CatalogDownloadChunk[]
  generation   MirrorGeneration       @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade, onUpdate: NoAction)
  run          SyncRun                @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([shopId, runId])
  @@map("catalog_downloads")
  @@schema("mirror")
}

model CatalogDownloadChunk {
  shopId         String          @map("shop_id")
  runId          BigInt          @map("run_id")
  byteStart      BigInt          @map("byte_start")
  byteEnd        BigInt          @map("byte_end")
  lineStart      BigInt          @map("line_start")
  lineCount      Int             @map("line_count")
  lines          Json
  checksum       String
  sourceChecksum String          @map("source_checksum")
  download       CatalogDownload @relation(fields: [shopId, runId], references: [shopId, runId], onDelete: Cascade, onUpdate: NoAction)

  @@id([shopId, runId, byteStart])
  @@index([shopId, runId, lineStart], map: "catalog_download_line_seek")
  @@map("catalog_download_chunks")
  @@schema("mirror")
}
