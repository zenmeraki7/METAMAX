// METAMAX publication domain. Loaded together through prisma.config.mjs.

model MirrorGeneration {
  shopId                String                      @map("shop_id")
  id                    String                      @default(uuid())
  status                GenerationStatus            @default(INGESTING)
  coverageRevision      String                      @default(uuid()) @map("coverage_revision")
  mirrorSchemaVersion   String                      @map("mirror_schema_version")
  sourceContractVersion String                      @map("source_contract_version")
  mappingVersion        String                      @map("mapping_version")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt            DateTime?                   @map("verified_at") @db.Timestamptz(3)
  publishedAt           DateTime?                   @map("published_at") @db.Timestamptz(3)
  retiredAt             DateTime?                   @map("retired_at") @db.Timestamptz(3)
  retainUntil           DateTime?                   @map("retain_until") @db.Timestamptz(3)
  requiredDatasets      String[]                    @default(["products", "variants"]) @map("required_datasets")
  historyLock          Int                         @default(0) @map("_history_lock")
  catalogDownloads      CatalogDownload[]
  catalogExecutions     CatalogImportExecution[]
  categories            Category[]
  collections           SnapshotCollection[]
  datasets              MirrorCoverage[]
  exportJobs            ExportJob[]
  exportManifestJobs    ExportManifestJob[]
  mappings              FieldMapping[]
  productRevisions      GenerationProductRevision[]
  leases                GenerationReadLease[]
  merchant              Shop                        @relation(fields: [shopId], references: [id])
  ingestions            SyncRun[]
  inventoryItems        InventoryItem[]
  locations             Location[]
  products              SnapshotProduct[]
  publications          MirrorPublication[]
  selections            SelectionSnapshot[]

  @@id([shopId, id])
  @@unique([shopId, id, coverageRevision, mappingVersion])
  @@index([shopId, status, createdAt])
  @@map("generations")
  @@schema("mirror")
}

model MirrorPublication {
  shopId           String           @id @map("shop_id")
  generationId     String           @map("generation_id")
  coverageRevision String           @map("coverage_revision")
  mappingVersion   String           @map("mapping_version")
  publishedAt      DateTime         @default(now()) @map("published_at") @db.Timestamptz(3)
  historyLock      Int              @default(0) @map("_history_lock")
  generation       MirrorGeneration @relation(fields: [shopId, generationId, coverageRevision, mappingVersion], references: [shopId, id, coverageRevision, mappingVersion], onUpdate: Restrict)

  @@map("publications")
  @@schema("mirror")
}

model MirrorCoverage {
  shopId           String           @map("shop_id")
  generationId     String           @map("generation_id")
  name             String
  status           CoverageStatus   @default(PENDING)
  durableRows      BigInt           @default(0) @map("durable_rows")
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz(3)
  verificationHash String?          @map("verification_hash")
  historyLock     Int              @default(0) @map("_history_lock")
  generation       MirrorGeneration @relation(fields: [shopId, generationId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, generationId, name])
  @@map("coverage")
  @@schema("mirror")
}

model GenerationReadLease {
  shopId             String              @map("shop_id")
  id                 String              @default(uuid())
  generationId       String              @map("generation_id")
  coverageRevision   String              @map("coverage_revision")
  mappingVersion     String              @map("mapping_version")
  operation          String
  owner              String
  expiresAt          DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  exportManifestJobs ExportManifestJob[]
  generation         MirrorGeneration    @relation(fields: [shopId, generationId, coverageRevision, mappingVersion], references: [shopId, id, coverageRevision, mappingVersion], onUpdate: Restrict)

  @@id([shopId, id])
  @@index([shopId, expiresAt])
  @@index([shopId, generationId, expiresAt])
  @@index([shopId, operation, owner])
  @@map("generation_read_leases")
  @@schema("mirror")
}

enum GenerationStatus {
  INGESTING
  RECONCILING
  VERIFIED
  PUBLISHED
  RETIRED
  FAILED

  @@schema("mirror")
}

enum CoverageStatus {
  PENDING
  INGESTING
  COMPLETE
  FAILED

  @@schema("mirror")
}
