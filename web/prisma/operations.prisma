// METAMAX operations domain. Loaded together through prisma.config.mjs.

model JobCommand {
  id                  BigInt                 @id @default(autoincrement())
  shopId              String                 @map("shop_id")
  contractId          String                 @map("contract_id")
  idempotencyKey      String                 @map("idempotency_key")
  kind                String
  status              WorkStatus             @default(PENDING)
  attempts            Int                    @default(0)
  maxAttempts         Int                    @default(8) @map("max_attempts")
  availableAt         DateTime               @default(now()) @map("available_at") @db.Timestamptz(3)
  cancelRequestedAt   DateTime?              @map("cancel_requested_at") @db.Timestamptz(3)
  leaseToken          String?                @map("lease_token")
  leaseUntil          DateTime?              @map("lease_until") @db.Timestamptz(3)
  fence               BigInt                 @default(0)
  checkpoint          Json?
  result              Json?
  lastError           String?                @map("last_error")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  historyLock        Int                    @default(0) @map("_history_lock")
  installationVersion String?                @map("installation_version")
  edits               EditOperation?
  exportJobs          ExportJob[]
  idempotency         IdempotencyRecord[]
  artifacts           JobArtifact[]
  contract            PreviewContract        @relation(fields: [shopId, contractId], references: [shopId, id])
  items               EditItem[]
  finalization        OperationFinalization?
  outbox              OutboxEvent[]
  scheduleOccurrences ScheduleOccurrence[]

  @@unique([shopId, id])
  @@unique([shopId, idempotencyKey])
  @@unique([shopId, kind, contractId], map: "job_commands_approved_operation_key")
  @@index([kind, status, id], map: "operation_finalization_command_scan")
  @@index([availableAt, id], map: "job_commands_due", where: raw("(status = ANY (ARRAY['PENDING'::\"WorkStatus\", 'RETRY'::\"WorkStatus\"]))"))
  @@index([status, availableAt, id], map: "job_commands_history_claim_idx", where: raw("((installation_version IS NOT NULL) AND (kind = ANY (ARRAY['bulk_edit'::text, 'undo'::text])))"))
  @@index([leaseUntil, id], map: "job_commands_recover", where: raw("(status = 'RUNNING'::\"WorkStatus\")"))
  @@map("job_commands")
  @@schema("mirror")
}

model JobSchedule {
  id                  BigInt               @id @default(autoincrement())
  shopId              String               @map("shop_id")
  enabled             Boolean              @default(false)
  timezone            String
  recurrence          String
  operation           String
  template            Json
  nextRunAt           DateTime             @map("next_run_at") @db.Timestamptz(3)
  lastRunAt           DateTime?            @map("last_run_at") @db.Timestamptz(3)
  leaseToken          String?              @map("lease_token")
  leaseUntil          DateTime?            @map("lease_until") @db.Timestamptz(3)
  fence               BigInt               @default(0)
  installationVersion String?              @map("installation_version")
  merchant            Shop                 @relation(fields: [shopId], references: [id])
  occurrences         ScheduleOccurrence[]

  @@unique([shopId, id])
  @@index([nextRunAt, id], map: "job_schedules_due", where: raw("enabled"))
  @@map("job_schedules")
  @@schema("mirror")
}

model ScheduleOccurrence {
  id                  String             @id
  shopId              String             @map("shop_id")
  scheduleId          BigInt             @map("schedule_id")
  scheduledFor        DateTime           @map("scheduled_for") @db.Timestamptz(3)
  template            Json
  operation           String
  status              String             @default("QUEUED")
  phase               String             @default("SELECT")
  snapshotId          String?            @map("snapshot_id")
  contractId          String?            @map("contract_id")
  commandId           BigInt?            @map("command_id")
  attempts            Int                @default(0)
  fence               BigInt             @default(0)
  leaseToken          String?            @map("lease_token")
  leaseUntil          DateTime?          @map("lease_until") @db.Timestamptz(3)
  nextAttemptAt       DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError           String?            @map("last_error")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)
  installationVersion String?            @map("installation_version")
  executionResult     Json?              @map("execution_result")
  command             JobCommand?        @relation(fields: [shopId, commandId], references: [shopId, id], onUpdate: NoAction)
  contract            PreviewContract?   @relation(fields: [shopId, contractId], references: [shopId, id], onUpdate: NoAction)
  schedule            JobSchedule        @relation(fields: [shopId, scheduleId], references: [shopId, id], onUpdate: NoAction)
  snapshot            SelectionSnapshot? @relation(fields: [shopId, snapshotId], references: [shopId, id], onUpdate: NoAction)

  @@unique([shopId, id])
  @@unique([shopId, scheduleId, scheduledFor])
  @@index([status, nextAttemptAt, leaseUntil], map: "schedule_occurrences_due")
  @@map("schedule_occurrences")
  @@schema("mirror")
}

model JobArtifact {
  id         BigInt     @id @default(autoincrement())
  shopId     String     @map("shop_id")
  commandId  BigInt     @map("command_id")
  objectKey  String     @map("object_key")
  kind       String
  sha256     String
  byteLength BigInt     @map("byte_length")
  rowCount   BigInt?    @map("row_count")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  command    JobCommand @relation(fields: [shopId, commandId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, objectKey])
  @@index([shopId, commandId])
  @@map("job_artifacts")
  @@schema("mirror")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  shopId      String   @map("shop_id")
  operationId String?  @map("operation_id")
  action      String
  actorId     String?  @map("actor_id")
  outcome     String
  summary     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant    Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt, id])
  @@map("audit_events")
  @@schema("mirror")
}

enum WorkStatus {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED

  @@schema("mirror")
}
