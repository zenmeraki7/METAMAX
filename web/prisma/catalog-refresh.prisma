// Migration-owned Edit History schema.

model CatalogRefreshRequest {
  shopId              String   @id @map("shop_id")
  installationVersion String   @map("installation_version")
  requestedRevision   BigInt   @default(1) @map("requested_revision")
  scheduledRevision   BigInt   @default(0) @map("scheduled_revision")
  attempts            Int      @default(0)
  nextAttemptAt       DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  reviewRequired      Boolean  @default(false) @map("review_required")
  lastError           String?  @map("last_error")
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([nextAttemptAt, shopId], map: "catalog_refresh_requests_due", where: raw("(requested_revision > scheduled_revision)"))
  @@map("catalog_refresh_requests")
  @@schema("mirror")
}
