// METAMAX bulk-editing domain. Loaded through prisma.config.mjs.

model EditItem {
  id                BigInt                  @id @default(autoincrement())
  shopId            String                  @map("shop_id")
  commandId         BigInt                  @map("command_id")
  resourceId        String                  @map("resource_id")
  status            WorkStatus              @default(PENDING)
  intendedValues    Json                    @map("intended_values")
  observedRevision  BigInt?                 @map("observed_revision")
  attempts          Int                     @default(0)
  nextAttemptAt     DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  lastError         String?                 @map("last_error")
  restoreSnapshotId BigInt?                 @map("restore_snapshot_id")
  historyLock      Int                     @default(0) @map("_history_lock")
  operation         EditOperation           @relation(fields: [shopId, commandId], references: [shopId, commandId], map: "edit_item_operation_fkey")
  command         JobCommand              @relation(fields: [shopId, commandId], references: [shopId, id], onDelete: Cascade, map: "job_items_shop_id_command_id_fkey")
  restoreSnapshot   ProductSnapshot?        @relation("RestoreSnapshot", fields: [shopId, restoreSnapshotId], references: [shopId, id])
  finalizations     OperationFinalization[]
  capturedSnapshot  ProductSnapshot?        @relation("CapturedSnapshot")

  @@unique([shopId, id])
  @@unique([shopId, commandId, resourceId])
  @@index([shopId, commandId, status, id])
  @@map("job_items")
  @@schema("mirror")
}

model PreviewContract {
  shopId              String               @map("shop_id")
  id                  String               @default(uuid())
  snapshotId          String               @map("snapshot_id")
  operation           String
  approvalRevision    String               @default(uuid()) @map("approval_revision")
  status              ApprovalStatus       @default(DRAFT)
  contract            Json
  contractHash        String               @map("contract_hash")
  approvedBy          String?              @map("approved_by")
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz(3)
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(3)
  hashVersion         String               @default("legacy-v1") @map("hash_version")
  canonicalContract   String?              @map("canonical_contract")
  historyLock        Int                  @default(0) @map("_history_lock")
  edits               EditOperation[]
  snapshot            SelectionSnapshot    @relation(fields: [shopId, snapshotId], references: [shopId, id])
  importPreviews      ImportPreview[]
  commands            JobCommand[]
  scheduleOccurrences ScheduleOccurrence[]

  @@id([shopId, id])
  @@map("execution_contracts")
  @@schema("mirror")
}

model EditOperation {
  id           BigInt          @id @default(autoincrement())
  shopId       String          @map("shop_id")
  commandId    BigInt          @map("command_id")
  previewId    String          @map("preview_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  historyLock Int             @default(0) @map("_history_lock")
  command      JobCommand      @relation(fields: [shopId, commandId], references: [shopId, id])
  preview      PreviewContract @relation(fields: [shopId, previewId], references: [shopId, id])
  items        EditItem[]
  restorations UndoOperation?  @relation("UndoRestore")
  sourceUndos  UndoOperation[] @relation("UndoSource")

  @@unique([shopId, id])
  @@unique([shopId, commandId])
  @@map("edit_operations")
  @@schema("mirror")
}
