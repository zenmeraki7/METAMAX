{
  "name": "metamax-shopify-app",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon index.js --ignore ./frontend",
    "serve": "node scripts/serve.mjs",
    "debug": "node --inspect-brk index.js",
    "test": "node --experimental-test-module-mocks --test export/*.test.js fields/*.test.js mirror/*.test.js services/*.test.js workers/*.test.js filters/__tests__/*.test.js edit-history/tests/history-contract.test.js edit-history/tests/history-repository.test.js edit-history/tests/execution-authority.test.js edit-history/tests/history-security.test.js edit-history/tests/snapshot-service.test.js edit-history/tests/undo-conflict.test.js edit-history/tests/undo-recovery.test.js template-tests/server.test.js",
    "history:verify-security": "node scripts/verify-history-security.js",
    "history:maintenance": "node scripts/history-maintenance.mjs",
    "test:history": "node scripts/test-history.js",
    "test:history:postgres": "node scripts/test-filter-postgres.js --history",
    "test:history:upgrade": "node scripts/test-filter-postgres.js --history-upgrade",
    "test:fields": "node --experimental-test-module-mocks --test fields/*.test.js mirror/*.test.js",
    "test:filters": "node --experimental-test-module-mocks --test filters/__tests__/*.test.js",
    "test:postgres": "node scripts/test-filter-postgres.js",
    "test:phase1:postgres": "node scripts/test-filter-postgres.js --phase1",
    "test:sync-progress:postgres": "node scripts/test-filter-postgres.js --sync-progress",
    "test:roles:postgres": "node scripts/test-filter-postgres.js --roles",
    "test:schema": "node scripts/test-filter-postgres.js --schema",
    "test:operations": "node scripts/test-filter-postgres.js --operations",
    "test:exports": "node scripts/test-filter-postgres.js --exports",
    "redis:check": "node scripts/check-redis.js",
    "db:check": "node scripts/check-db.js",
    "db:verify:filters": "node scripts/verify-filter-schema.js",
    "verify:integration-imports": "node scripts/verify-integration-imports.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@shopify/shopify-api": "^11.14.1",
    "@shopify/shopify-app-express": "^5.0.8",
    "@shopify/shopify-app-session-storage-postgresql": "^4.0.20",
    "bullmq": "^6.5.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "serve-static": "^1.16.2"
  },
  "overrides": {
    "exceljs": { "uuid": "^11.1.1" }
  },
  "devDependencies": {
    "@shopify/shopify-app-session-storage-memory": "^4.0.20",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0"
  }
}
