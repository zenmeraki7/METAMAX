  @@index([shop_id, installation_id, operation_id], map: "eh_unresolved_execution_idx", where: raw("(request_state = ANY (ARRAY['DISPATCH_AUTHORIZED'::text, 'ACKNOWLEDGED'::text, 'OUTCOME_UNKNOWN'::text]))"))
  @@index([shop_id, installation_id, execution_item_id, operation_id], map: "eh_verified_execution_item_idx", where: raw("(request_state = 'VERIFIED'::text)"))
