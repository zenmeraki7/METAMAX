  @@index([shop_id, installation_id, created_at(sort: Desc), id(sort: Desc)], map: "eh_op_history_idx")
  @@index([retained_until, id], map: "eh_op_retention_idx", where: raw("((retained_until IS NOT NULL) AND (legal_hold = false))"))
  @@index([retained_until, created_at, id], map: "eh_retention_due", where: raw("(NOT legal_hold)"))
