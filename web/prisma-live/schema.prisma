model changes {
  id                          String           @id @db.Uuid
  shop_id                     String
  installation_id             String
  operation_id                String           @db.Uuid
  execution_item_id           BigInt
  mutation_id                 String
  attempt_id                  String
  attempt_number              Int
  execution_fence_epoch       BigInt
  execution_claim_id          String
  resource_gid                String
  resource_family_gid         String
  field_id                    String
  field_definition_revision   String
  mutation_plan_fingerprint   String
  intended_value_fingerprint  String
  before_snapshot_fingerprint String
  mutation_state              String           @default("PREPARED")
  verification_state          String           @default("NOT_CHECKED")
  last_evidence_kind          String?
  last_evidence_fingerprint   String?
  outcome_code                String?
  prepared_at                 DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  dispatch_started_at         DateTime?        @db.Timestamptz(6)
  acknowledged_at             DateTime?        @db.Timestamptz(6)
  verified_at                 DateTime?        @db.Timestamptz(6)
  updated_at                  DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  operations                  operations       @relation(fields: [shop_id, installation_id, operation_id], references: [shop_id, installation_id, id], onUpdate: NoAction, map: "eh_change_operation_fk")
  recovery_tasks              recovery_tasks[]
  snapshots                   snapshots[]

  @@unique([shop_id, installation_id, operation_id, mutation_id, attempt_number, resource_gid, field_id], map: "eh_change_attempt_number_resource_field_unique")
  @@unique([shop_id, installation_id, operation_id, mutation_id, attempt_id, resource_gid, field_id], map: "eh_change_attempt_resource_field_unique")
  @@unique([shop_id, installation_id, operation_id, id], map: "eh_change_operation_key")
  @@unique([shop_id, installation_id, id], map: "eh_change_tenant_key")
  @@index([shop_id, installation_id, execution_item_id], map: "eh_change_execution_item_idx")
  @@index([shop_id, installation_id, resource_family_gid, prepared_at(sort: Desc)], map: "eh_change_family_idx")
  @@index([shop_id, installation_id, operation_id, prepared_at, id], map: "eh_change_operation_idx")
  @@index([shop_id, installation_id, resource_gid, prepared_at(sort: Desc), id(sort: Desc)], map: "eh_change_resource_idx")
  @@index([shop_id, installation_id, updated_at, id], map: "eh_change_unknown_idx", where: raw("(mutation_state = 'OUTCOME_UNKNOWN'::text)"))
  @@index([shop_id, installation_id, operation_id, resource_gid, field_id, prepared_at(sort: Desc), attempt_number(sort: Desc), id(sort: Desc)], map: "eh_undo_source_read_idx")
  @@index([shop_id, resource_family_gid], map: "eh_unresolved_family_idx", where: raw("(mutation_state = ANY (ARRAY['DISPATCHING'::text, 'OUTCOME_UNKNOWN'::text, 'ACKNOWLEDGED'::text]))"))
  @@schema("edit_history")
}

