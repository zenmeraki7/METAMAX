# Shopify CLI injects the API key, secret, scopes and HOST during `npm run dev`.
# Set these values explicitly for standalone/production hosting.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products
HOST=https://your-app.example.com
PORT=3000
REDIS_URL=redis://127.0.0.1:6380
# Copy the pooled Neon URL into web/.env. Never commit credentials.
DATABASE_URL=
# Direct URL for Prisma CLI migrations/admin; configured in prisma.config.mjs.
DIRECT_DATABASE_URL=
# Persistent server-only signing key (32+ bytes). Defaults to SHOPIFY_API_SECRET
# when Shopify CLI supplies it; configure a separate key for hosted deployments.
FILTER_CURSOR_SECRET=

# Enabling exports fails startup unless migrations, Redis, verified Field/Filter
# Engines, S3 credentials and bucket versioning are available. No mocks/fallbacks.
EXPORTS_ENABLED=false
EXPORT_S3_BUCKET=
EXPORT_S3_REGION=
# Omit for AWS; set an HTTPS endpoint for another S3-compatible provider.
EXPORT_S3_ENDPOINT=
EXPORT_S3_FORCE_PATH_STYLE=true
EXPORT_S3_PREFIX=metamax-exports
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN or the standard
# AWS workload-role credential chain supplies private server-only credentials.
# History security: separate restricted logins; never use migration-owner credentials.
HISTORY_DATABASE_URL=
HISTORY_AUTHORITY_RELATIONS_JSON=[]
HISTORY_PRIVACY_DATABASE_URL=
HISTORY_MAINTENANCE_DATABASE_URL=
HISTORY_MAINTENANCE_ENABLED=false
# Secret manager values. Keep historical key IDs available until rekey/retention permits retirement.
HISTORY_ENCRYPTION_ACTIVE_KEY_ID=
HISTORY_ENCRYPTION_KEYS_JSON=
