# Application runtime.
# Use the Neon pooled connection endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Migration connection.
# Use the Neon direct endpoint.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Per Node.js process.
DATABASE_POOL_MAX=5

DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

SHOPIFY_API_SECRET=
SHOPIFY_API_KEY=
HOST=https://your-app.example.com
SCOPES=read_products,read_inventory,read_locations
# Only set the previous secret during Shopify credential rotation.
SHOPIFY_API_SECRET_PREVIOUS=
SHOPIFY_WEBHOOK_BODY_LIMIT=5mb
REDIS_URL=redis://127.0.0.1:6379
RECONCILE_CONCURRENCY=5
RECONCILE_SCAN_INTERVAL_MS=5000
RECONCILE_SHOPS_PER_SCAN=20
RECONCILE_PRODUCTS_PER_SHOP=5
RECONCILE_MAX_QUEUED_JOBS=2000
RECONCILE_SHUTDOWN_TIMEOUT_MS=360000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=newmeta
# Optional: override for a jurisdiction-specific R2 endpoint.
R2_ENDPOINT=

RECONCILE_SCAN_LIMIT=100
RECONCILE_MAX_BACKLOG=2000
